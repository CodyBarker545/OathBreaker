# Godot / Visual Studio / .NET generated files
.godot/
.vs/
.vscode/*
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
[Bb]in/
[Oo]bj/
*.user
*.suo
*.userosscache
*.sln.docstates
*.log
*.blend1

.nuget-local/*
!.nuget-local/.gitkeep
!.nuget-local/.gdignore
.dotnet-home/

# Python caches and Visual Studio migration reports
__pycache__/
*.py[cod]
UpgradeLog.htm

# Game assets - stored locally, not on GitHub
/SourceAssets/
/Assets/
/artifacts/

# Blender and 3D models
*.blend
*.blend1
*.blend2
*.fbx
*.glb
*.gltf
*.obj
*.stl

# Large asset archives
*.zip
*.7z
*.rar

# Generated caches
.godot/
**/bin/
**/obj/
__pycache__/
*.pyc


# Keep small Godot resources and shaders in Git
!/Assets/
!/Assets/**/
!/Assets/**/*.tres
!/Assets/**/*.tscn
!/Assets/**/*.gdshader
!/Assets/**/*.gdshader.uid

# Exclude bulky level terrain data
/Assets/Levels/**/TerrainData/

